<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/button_green_backward"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="0dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <TextView
                android:id="@+id/rate_experience_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/rate_experience"
                android:textColor="@android:color/black"
                android:textSize="25sp"
                android:fontFamily="@font/montserrat_extrabold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <RatingBar
                android:id="@+id/rating_bar"
                style="?android:attr/ratingBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:numStars="5"
                android:stepSize="1"
                app:layout_constraintTop_toBottomOf="@id/rate_experience_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/improve_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/improve_suggestion"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_extrabold"
                app:layout_constraintTop_toBottomOf="@id/rating_bar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tag_accuracy"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1.4"
                android:text="@string/tag_accuracy"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#919191"
                android:textSize="16sp"
                android:letterSpacing="0"
                android:fontFamily="@font/lato_black"
                android:background="@drawable/tag_hard_shadow"
                app:backgroundTint="@null"
                android:minHeight="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tag_sorting"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1.1"
                android:text="@string/tag_sorting"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#919191"
                android:textSize="16sp"
                android:letterSpacing="0"
                android:fontFamily="@font/lato_black"
                android:background="@drawable/tag_hard_shadow"
                app:backgroundTint="@null"
                android:minHeight="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tag_design"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1.0"
                android:text="@string/tag_design"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#919191"
                android:textSize="16sp"
                android:letterSpacing="0"
                android:fontFamily="@font/lato_black"
                android:background="@drawable/tag_hard_shadow"
                app:backgroundTint="@null"
                android:minHeight="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tag_reliability"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1.4"
                android:text="@string/tag_reliability"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#919191"
                android:textSize="16sp"
                android:letterSpacing="0"
                android:fontFamily="@font/lato_black"
                android:background="@drawable/tag_hard_shadow"
                app:backgroundTint="@null"
                android:minHeight="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tag_response"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1.2"
                android:text="@string/tag_response"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#919191"
                android:textSize="16sp"
                android:letterSpacing="0"
                android:fontFamily="@font/lato_black"
                android:background="@drawable/tag_hard_shadow"
                app:backgroundTint="@null"
                android:minHeight="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tag_ease"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1.0"
                android:text="@string/tag_ease"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#919191"
                android:textSize="16sp"
                android:letterSpacing="0"
                android:fontFamily="@font/lato_black"
                android:background="@drawable/tag_hard_shadow"
                app:backgroundTint="@null"
                android:minHeight="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/flow_tags"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:constraint_referenced_ids="tag_accuracy,tag_sorting,tag_design,tag_reliability,tag_response,tag_ease"
                app:flow_maxElementsWrap="2"
                app:flow_wrapMode="chain"
                app:flow_horizontalStyle="spread"
                app:flow_horizontalGap="6dp"
                app:flow_verticalGap="8dp"
                app:layout_constraintTop_toBottomOf="@id/improve_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/feedback_edit_text"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/edit_text_bg"
                android:gravity="top|start"
                android:hint="@string/feedback_hint"
                android:padding="16dp"
                android:textColor="#434343"
                android:textColorHint="#919191"
                android:textSize="16sp"
                android:textStyle="italic"
                android:fontFamily="@font/lato_black"
                android:autofillHints="none"
                android:inputType="textMultiLine"
                android:maxLength="200"
                app:layout_constraintTop_toBottomOf="@id/flow_tags"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/feedback_limit_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Max 200 characters"
                android:textSize="14sp"
                android:textColor="#919191"
                android:fontFamily="@font/lato_black"
                app:layout_constraintTop_toBottomOf="@id/feedback_edit_text"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/feedback_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 / 200"
                android:textSize="14sp"
                android:textColor="#919191"
                android:fontFamily="@font/lato_black"
                app:layout_constraintTop_toBottomOf="@id/feedback_edit_text"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/send_feedback_button"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/send_feedback"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:letterSpacing="0"
                android:fontFamily="@font/montserrat_extrabold"
                android:enabled="false"
                app:backgroundTint="#D9D9D9"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                android:stateListAnimator="@null"
                android:outlineSpotShadowColor="#80000000"
                android:outlineAmbientShadowColor="#80000000"
                tools:targetApi="p"
                app:layout_constraintTop_toBottomOf="@id/feedback_limit_text"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="1.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/submit_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D1A1A1A"
        android:clickable="true"
        android:focusable="true"
        android:translationZ="25dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="32dp">

                <TextView
                    android:id="@+id/submit_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:text="Submit Feedback?"
                    android:textColor="#467750"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/submit_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/lato_regular"
                    android:text="You will not be able to edit or delete this feedback after submission."
                    android:textColor="#434343"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cancel_submit"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:letterSpacing="0"
                        android:text="Cancel"
                        android:textAllCaps="false"
                        android:textColor="#467750"
                        android:textSize="20sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#89C07E"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_confirm_submit"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:text="Submit"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        app:backgroundTint="#89C07E"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/success_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D1A1A1A"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="32dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/thank_you_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feedback_success_msg"
                    android:textColor="#467750"
                    android:textSize="20sp"
                    android:textAlignment="center"
                    android:fontFamily="@font/montserrat_extrabold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/close_success_button"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginTop="32dp"
                    android:paddingHorizontal="48dp"
                    android:text="@string/action_close"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_extrabold"
                    app:backgroundTint="#89C07E"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/exit_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D1A1A1A"
        android:clickable="true"
        android:focusable="true"
        android:translationZ="25dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="32dp">

                <TextView
                    android:id="@+id/exit_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:text="Discard Feedback?"
                    android:textColor="#467750"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/exit_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/lato_regular"
                    android:text="If you leave now, your feedback will not be saved."
                    android:textColor="#434343"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cancel_exit"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:letterSpacing="0"
                        android:text="Cancel"
                        android:textAllCaps="false"
                        android:textColor="#467750"
                        android:textSize="20sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#89C07E"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_confirm_exit"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:text="Leave"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        app:backgroundTint="#89C07E"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>