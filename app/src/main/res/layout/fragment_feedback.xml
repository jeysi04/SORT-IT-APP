<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <!-- Rate your Experience Title -->
            <TextView
                android:id="@+id/rate_experience_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="@string/rate_experience"
                android:textColor="@android:color/black"
                android:textSize="25sp"
                android:fontFamily="@font/montserrat_extrabold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Rating Bar -->
            <RatingBar
                android:id="@+id/rating_bar"
                style="?android:attr/ratingBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:numStars="5"
                android:stepSize="1"
                app:layout_constraintTop_toBottomOf="@id/rate_experience_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Improve Suggestion Title -->
            <TextView
                android:id="@+id/improve_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="@string/improve_suggestion"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_extrabold"
                app:layout_constraintTop_toBottomOf="@id/rating_bar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Tag Buttons with Hard Shadow -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tag_accuracy"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1.4"
                android:text="@string/tag_accuracy"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#919191"
                android:textSize="16sp"
                android:letterSpacing="0"
                android:fontFamily="@font/lato_black"
                android:background="@drawable/tag_hard_shadow"
                app:backgroundTint="@null"
                android:minHeight="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tag_sorting"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1.1"
                android:text="@string/tag_sorting"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#919191"
                android:textSize="16sp"
                android:letterSpacing="0"
                android:fontFamily="@font/lato_black"
                android:background="@drawable/tag_hard_shadow"
                app:backgroundTint="@null"
                android:minHeight="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tag_design"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1.0"
                android:text="@string/tag_design"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#919191"
                android:textSize="16sp"
                android:letterSpacing="0"
                android:fontFamily="@font/lato_black"
                android:background="@drawable/tag_hard_shadow"
                app:backgroundTint="@null"
                android:minHeight="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tag_reliability"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1.4"
                android:text="@string/tag_reliability"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#919191"
                android:textSize="16sp"
                android:letterSpacing="0"
                android:fontFamily="@font/lato_black"
                android:background="@drawable/tag_hard_shadow"
                app:backgroundTint="@null"
                android:minHeight="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tag_response"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1.2"
                android:text="@string/tag_response"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#919191"
                android:textSize="16sp"
                android:letterSpacing="0"
                android:fontFamily="@font/lato_black"
                android:background="@drawable/tag_hard_shadow"
                app:backgroundTint="@null"
                android:minHeight="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tag_ease"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1.0"
                android:text="@string/tag_ease"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#919191"
                android:textSize="16sp"
                android:letterSpacing="0"
                android:fontFamily="@font/lato_black"
                android:background="@drawable/tag_hard_shadow"
                app:backgroundTint="@null"
                android:minHeight="52dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <!-- Flow helper -->
            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/flow_tags"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:constraint_referenced_ids="tag_accuracy,tag_sorting,tag_design,tag_reliability,tag_response,tag_ease"
                app:flow_maxElementsWrap="2"
                app:flow_wrapMode="chain"
                app:flow_horizontalStyle="spread"
                app:flow_horizontalGap="6dp"
                app:flow_verticalGap="8dp"
                app:layout_constraintTop_toBottomOf="@id/improve_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Feedback Box -->
            <EditText
                android:id="@+id/feedback_edit_text"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/edit_text_bg"
                android:gravity="top|start"
                android:hint="@string/feedback_hint"
                android:padding="16dp"
                android:textColor="#434343"
                android:textColorHint="#919191"
                android:textSize="16sp"
                android:textStyle="italic"
                android:fontFamily="@font/lato_black"
                android:autofillHints="none"
                android:inputType="textMultiLine"
                android:maxLength="200"
                app:layout_constraintTop_toBottomOf="@id/flow_tags"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Left: Max characters label -->
            <TextView
                android:id="@+id/feedback_limit_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Max 200 characters"
                android:textSize="14sp"
                android:textColor="#919191"
                android:fontFamily="@font/lato_black"
                app:layout_constraintTop_toBottomOf="@id/feedback_edit_text"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Right: Character counter -->
            <TextView
                android:id="@+id/feedback_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 / 200"
                android:textSize="14sp"
                android:textColor="#919191"
                android:fontFamily="@font/lato_black"
                app:layout_constraintTop_toBottomOf="@id/feedback_edit_text"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Send Feedback Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/send_feedback_button"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/send_feedback"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:letterSpacing="0"
                android:fontFamily="@font/montserrat_extrabold"
                app:backgroundTint="#89C07E"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                android:stateListAnimator="@null"
                android:outlineSpotShadowColor="#80000000"
                android:outlineAmbientShadowColor="#80000000"
                tools:targetApi="p"
                app:layout_constraintTop_toBottomOf="@id/feedback_limit_text"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Success Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/success_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D1A1A1A"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/thank_you_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feedback_success_msg"
                    android:textColor="#467750"
                    android:textSize="20sp"
                    android:textAlignment="center"
                    android:fontFamily="@font/montserrat_extrabold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/close_success_button"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginTop="32dp"
                    android:paddingHorizontal="48dp"
                    android:text="@string/action_close"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_extrabold"
                    app:backgroundTint="#89C07E"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>