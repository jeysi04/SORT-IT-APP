<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="75dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:background="@drawable/yellow_header_page">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Back"
                    android:padding="8dp"
                    android:src="@drawable/button_green_backward"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="24dp">

                <TextView
                    android:id="@+id/rate_experience_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:text="@string/rate_experience"
                    android:textColor="@android:color/black"
                    android:textSize="25sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.493"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RatingBar
                    android:id="@+id/rating_bar"
                    style="?android:attr/ratingBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:numStars="5"
                    android:stepSize="1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.495"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rate_experience_title" />

                <TextView
                    android:id="@+id/improve_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:text="@string/improve_suggestion"
                    android:textColor="@android:color/black"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rating_bar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_accuracy"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tag_hard_shadow"
                    android:fontFamily="@font/lato_black"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:minHeight="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/tag_accuracy"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="#919191"
                    android:textSize="16sp"
                    app:backgroundTint="@null"
                    app:layout_constraintHorizontal_weight="1.4" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_sorting"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tag_hard_shadow"
                    android:fontFamily="@font/lato_black"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:minHeight="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/tag_sorting"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="#919191"
                    android:textSize="16sp"
                    app:backgroundTint="@null"
                    app:layout_constraintHorizontal_weight="1.1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_design"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tag_hard_shadow"
                    android:fontFamily="@font/lato_black"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:minHeight="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/tag_design"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="#919191"
                    android:textSize="16sp"
                    app:backgroundTint="@null"
                    app:layout_constraintHorizontal_weight="1.0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_reliability"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tag_hard_shadow"
                    android:fontFamily="@font/lato_black"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:minHeight="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/tag_reliability"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="#919191"
                    android:textSize="16sp"
                    app:backgroundTint="@null"
                    app:layout_constraintHorizontal_weight="1.4" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_response"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tag_hard_shadow"
                    android:fontFamily="@font/lato_black"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:minHeight="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/tag_response"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="#919191"
                    android:textSize="16sp"
                    app:backgroundTint="@null"
                    app:layout_constraintHorizontal_weight="1.2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_ease"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tag_hard_shadow"
                    android:fontFamily="@font/lato_black"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0"
                    android:minHeight="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/tag_ease"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="#919191"
                    android:textSize="16sp"
                    app:backgroundTint="@null"
                    app:layout_constraintHorizontal_weight="1.0" />

                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/flow_tags"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:constraint_referenced_ids="tag_accuracy,tag_sorting,tag_design,tag_reliability,tag_response,tag_ease"
                    app:flow_horizontalGap="6dp"
                    app:flow_horizontalStyle="spread"
                    app:flow_maxElementsWrap="2"
                    app:flow_verticalGap="8dp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/improve_title" />

                <EditText
                    android:id="@+id/feedback_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="24dp"
                    android:autofillHints="none"
                    android:background="@drawable/edit_text_bg"
                    android:fontFamily="@font/lato_black"
                    android:gravity="top|start"
                    android:hint="@string/feedback_hint"
                    android:inputType="textMultiLine"
                    android:maxLength="200"
                    android:padding="16dp"
                    android:textColor="#434343"
                    android:textColorHint="#919191"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/flow_tags" />

                <TextView
                    android:id="@+id/feedback_limit_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/lato_black"
                    android:text="Max 200 characters"
                    android:textColor="#919191"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/feedback_edit_text" />

                <TextView
                    android:id="@+id/feedback_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/lato_black"
                    android:text="0 / 200"
                    android:textColor="#919191"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/feedback_edit_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/send_feedback_button"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="32dp"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:text="@string/send_feedback"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    app:backgroundTint="#89C07E"
                    app:cornerRadius="16dp"
                    app:elevation="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/feedback_limit_text" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/submit_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D1A1A1A"
        android:clickable="true"
        android:focusable="true"
        android:translationZ="25dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:id="@+id/submit_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:text="Submit Feedback?"
                    android:textColor="#467750"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/submit_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/lato_regular"
                    android:text="You will not be able to edit or delete this feedback after submission."
                    android:textColor="#434343"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cancel_submit"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:text="Cancel"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textColor="#467750"
                        android:textSize="20sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#89C07E"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_confirm_submit"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_extrabold"
                        android:text="Submit"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        app:backgroundTint="#89C07E"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/success_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D1A1A1A"
        android:clickable="true"
        android:focusable="true"
        android:translationZ="30dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:id="@+id/thank_you_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:text="@string/feedback_success_msg"
                    android:textAlignment="center"
                    android:textColor="#467750"
                    android:textSize="20sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/close_success_button"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginTop="32dp"
                    android:fontFamily="@font/montserrat_extrabold"
                    android:paddingHorizontal="48dp"
                    android:text="@string/action_close"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    app:backgroundTint="#89C07E"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>