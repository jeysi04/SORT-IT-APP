<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Sort-It Logo - Increased size to 500dp -->
    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="186dp"
        android:layout_height="186dp"
        android:src="@drawable/splashh"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <!-- Loading Bar - Adjusted width to 400dp -->
    <ProgressBar
        android:id="@+id/splashProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="146dp"
        android:layout_height="12dp"
        android:layout_marginTop="12dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/custom_loading_bar"
        app:layout_constraintEnd_toEndOf="@id/splashLogo"
        app:layout_constraintHorizontal_bias="0.475"
        app:layout_constraintStart_toStartOf="@id/splashLogo"
        app:layout_constraintTop_toBottomOf="@id/splashLogo" />

</androidx.constraintlayout.widget.ConstraintLayout>